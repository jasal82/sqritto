    "alt": { "type": "String", "description": "Alternativtext für Barrierefreiheit" },
    "width": { "type": "String", "description": "Breite, z. B. 60% oder 300px" }
  },
  "snippet": "{% figure src=\"${/assets/bild.png}\" caption=\"${Beschriftung}\" width=\"80%\" /%}",
  "en": {
    "title": "Figure",
    "description": "Image with caption, width and automatic numbering in the PDF.",
